{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "Sqlite": "Data Source=appdata/allowlist.db" },
  "Cloudflare": {
    "Mode": "Fake", "ApiBase": "https://api.cloudflare.com/client/v4", "AccountId": "", "ApiToken": "",
    "AllowRemoveUnknown": false, "MaxAttempts": 6,
    "Fake": { "FailureRate": 0, "TimeoutRate": 0 }
  },
  "Jwt": { "Issuer": "allowlist-manager", "Audience": "allowlist-manager" },
  "Seed": {
    "AdminUsername": "admin",
    "DevAllowListId": "demo-dev-allow", "DevBlockListId": "demo-dev-block",
    "StagingAllowListId": "demo-staging-allow", "StagingBlockListId": "demo-staging-block",
    "ProdAllowListId": "demo-prod-allow", "ProdBlockListId": "demo-prod-block"
  }
}
