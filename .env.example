# Copy to .env (git-ignored) and replace every value before running docker compose.
POSTGRES_PASSWORD=replace-with-a-random-database-password
JWT_SIGNING_KEY=replace-with-a-random-signing-key-at-least-32-bytes
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional: leave empty to skip creating the read-only viewer account.
VIEWER_PASSWORD=
